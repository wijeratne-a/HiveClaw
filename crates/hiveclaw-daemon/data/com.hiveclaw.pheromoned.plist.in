<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hiveclaw.pheromoned</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PROGRAM@</string>
		<string>--latent-dim</string>
		<string>256</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.hiveclaw.pheromoned</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
